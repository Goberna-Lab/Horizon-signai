[Unit]
Description=Horizon voz — Kokoro «am_michael» y faster-whisper en inglés (ambos en GPU) para el chat de voz de Horizon
# Servicio de USUARIO (systemctl --user) de manolito en Geografo: ~/.config/systemd/user/.
# Escucha solo en la IP del tailnet; necesita `loginctl enable-linger manolito` para arrancar sin sesión.
After=network-online.target

[Service]
WorkingDirectory=%h/.local/share/horizon-voz/src
ExecStart=%h/.local/share/horizon-voz/venv/bin/python -I %h/.local/share/horizon-voz/src/servidor.py
Environment=HVOZ_IP=100.117.204.80
Environment=HVOZ_PUERTO=8796
Environment=HVOZ_TOKEN_ARCHIVO=%h/.config/horizon-voz/token
# Boca: Kokoro-82M «am_michael» (rápido). Para volver a Ryan (Qwen3-TTS, ~2× más lento que el audio):
#   HVOZ_MOTOR=qwen, HVOZ_VOZ=Ryan, HVOZ_DTYPE=float32,
#   HVOZ_MODELO_TTS=%h/.local/share/horizon-voz/modelos/qwen3-tts-0.6b-customvoice
Environment=HVOZ_MOTOR=kokoro
Environment=HVOZ_VOZ=am_michael
Environment=HVOZ_IDIOMA=English
# Oído: large-v3-turbo es el más preciso del banco (voz/banco-stt): 0,1 % de error en limpio y 1,0 %
# con ruido, contra 1,7 % y 2,8 % de small.en, por ~0,1 s más. Volver: faster-whisper-small.en
Environment=HVOZ_MODELO_STT=%h/.local/share/horizon-voz/modelos/faster-whisper-large-v3-turbo
Environment="HVOZ_PISTAS_STT=Moon, lunar south pole, Shackleton crater, Malapert Massif, Connecting Ridge, Artemis, regolith, permanently shadowed region."
# Oído en GPU (~0,17 s); «cpu» lo devuelve a la CPU (~1,7 s). HVOZ_HILOS_STT solo aplica en CPU.
Environment=HVOZ_DISPOSITIVO_STT=cuda
Environment=HVOZ_HILOS_STT=4
Environment=HF_HOME=%h/.local/share/horizon-voz/cache
Environment=HF_HUB_OFFLINE=1
# librosa (vía qwen-tts) compila con numba y cachea; que no lo haga junto al código
Environment=NUMBA_CACHE_DIR=%h/.local/share/horizon-voz/cache/numba
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=OMP_NUM_THREADS=4
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=15
Nice=10
MemoryMax=8G

[Install]
WantedBy=default.target
